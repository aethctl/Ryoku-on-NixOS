#!/usr/bin/env bash

# Ryoku pre-commit checks staged changes for basic repository hygiene:
#   1. git whitespace/errors
#   2. shell syntax
#   3. low-value conversational filler in newly added comments
#   4. update-delivery coverage for shipped user config

set -euo pipefail

fail() {
  echo "" >&2
  echo "pre-commit rejected this commit:" >&2
  echo "  $1" >&2
  echo "" >&2
  exit 1
}

exempt='^ryoku/lockscreen/qylock/|^ryoku/shell/quickshell/shell/modules/bar/barstyles/qsbar/'

git diff --cached --check \
  || fail "git diff --check found whitespace or conflict-marker errors."

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM)

for f in "${staged[@]}"; do
  [[ -f "$f" ]] || continue
  [[ "$f" =~ $exempt ]] && continue

  case "$f" in
    *.sh|*.bash) ;;
    *)
      first=$(head -n1 "$f" 2>/dev/null || true)
      [[ "$first" == '#!'*bash* || "$first" == '#!/bin/sh' || "$first" == '#!/usr/bin/env sh' ]] || continue
      ;;
  esac

  if ! git show ":$f" | bash -n 2>/tmp/ryoku-bashn.err; then
    cat /tmp/ryoku-bashn.err >&2
    fail "bash syntax error in $f."
  fi
done

bin/ryoku-dev-check-comments --staged >/dev/null \
  || fail "low-value filler comments found; reword or remove them."

bin/ryoku-dev-verify-delivery --quiet \
  || fail "a user config reaches no installed system; see docs/updates.md."

exit 0
