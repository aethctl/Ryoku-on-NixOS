#!/bin/bash
# Ryoku Motion cursor sampler for the Hyprland session. studiorecord is a
# compositor-neutral shell script that drives the recorder and the editor; the
# pointer position it needs for cursor-follow zoom is a Hyprland IPC query niri
# has no equivalent for, so that read lives here in the Hyprland payload and is
# reached by capability. One long-lived process, not a per-tick fork of the seam.
#
#   ryoku-cursor-track <raw-file>
#
# Prints one geometry line (MX MY MW MH, the focused monitor in logical pixels)
# to stdout, then appends "<ms-since-start> <x> <y>" to <raw-file> every 0.05 s
# until killed. When there is no live cursor feed it exits 3 without printing
# geometry, so the caller knows to record without the sidecar.
set -uo pipefail

raw="${1:-}"
[[ -n $raw ]] || { echo "usage: ryoku-cursor-track <raw-file>" >&2; exit 2; }

# Probe once so a dead query never gets busy-looped and no empty track is written.
# No x,y means no cursor feed: bail before the geometry line so the caller drops
# straight into the plain recording path.
[[ "$(hyprctl cursorpos 2>/dev/null || true)" == *,* ]] || exit 3

# Focused monitor geometry in logical coordinates, to normalise the global cursor
# position to 0..1 within the recorded screen. Falls back to a common default
# when the query is unusable.
MX=0; MY=0; MW=1920; MH=1080
geom="$(hyprctl -j monitors 2>/dev/null \
  | jq -r '(([.[] | select(.focused)] + .)[0]) | "\(.x) \(.y) \(.width / .scale) \(.height / .scale)"' 2>/dev/null || true)"
read -r MX MY MW MH <<<"${geom:-0 0 1920 1080}"
if [[ ! ${MW:-0} =~ ^[0-9.]+$ ]] || [[ $(awk -v w="${MW:-0}" 'BEGIN{print (w>0)}') != 1 ]]; then
  MX=0; MY=0; MW=1920; MH=1080
fi
printf '%s %s %s %s\n' "$MX" "$MY" "$MW" "$MH"

# Sample the pointer at 20 Hz until killed, timestamps relative to sampling start.
start=$(date +%s%3N)
while :; do
  pos="$(hyprctl cursorpos 2>/dev/null || true)"
  now=$(date +%s%3N)
  if [[ $pos == *,* ]]; then
    x="${pos%%,*}"
    y="${pos##*,}"
    x="${x//[^0-9-]/}"
    y="${y//[^0-9-]/}"
    [[ -n $x && -n $y ]] && printf '%s %s %s\n' "$((now - start))" "$x" "$y" >>"$raw"
  fi
  sleep 0.05
done
