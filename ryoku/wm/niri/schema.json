[
  {
    "tab": "Layout",
    "group": "COLUMN WIDTHS",
    "key": "wm.niri.presetColumnWidths",
    "label": "Widths to cycle",
    "desc": "The widths a window steps through when you press the column-width key",
    "ctl": "chips",
    "src": "desktop.json",
    "page": "windowmanager",
    "opts": [
      "0.5",
      "0.33333, 0.66667",
      "0.33333, 0.5, 0.66667",
      "0.25, 0.5, 0.75"
    ],
    "optLabels": {
      "0.5": "Half",
      "0.33333, 0.66667": "Thirds",
      "0.33333, 0.5, 0.66667": "Thirds and half",
      "0.25, 0.5, 0.75": "Quarters"
    }
  },
  {
    "tab": "Layout",
    "group": "SCREEN EDGE GAPS",
    "key": "wm.niri.struts.left",
    "label": "Left edge",
    "desc": "Space kept clear along the left edge, so a bar or dock there is never covered by a window",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 256,
    "unit": "px",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "SCREEN EDGE GAPS",
    "key": "wm.niri.struts.right",
    "label": "Right edge",
    "desc": "Space kept clear along the right edge, so a bar or dock there is never covered by a window",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 256,
    "unit": "px",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "SCREEN EDGE GAPS",
    "key": "wm.niri.struts.top",
    "label": "Top edge",
    "desc": "Space kept clear along the top edge, so a bar or dock there is never covered by a window",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 256,
    "unit": "px",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "SCREEN EDGE GAPS",
    "key": "wm.niri.struts.bottom",
    "label": "Bottom edge",
    "desc": "Space kept clear along the bottom edge, so a bar or dock there is never covered by a window",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 256,
    "unit": "px",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "FRAMES",
    "key": "wm.niri.preferNoCsd",
    "label": "Server-side window frames",
    "desc": "Ask apps to drop their own title bars so niri draws the frame",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "OVERVIEW",
    "key": "wm.niri.overviewZoom",
    "label": "Overview zoom",
    "desc": "How far the overview pulls back, lower fits more workspaces on screen",
    "ctl": "slid",
    "src": "desktop.json",
    "lo": 0.1,
    "hi": 0.75,
    "unit": "%",
    "pct": true,
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "OVERVIEW",
    "key": "wm.niri.hotCorners",
    "label": "Hot corners",
    "desc": "Push the pointer into a screen corner to open the overview",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "STARTUP",
    "key": "wm.niri.hotkeyOverlaySkip",
    "label": "Skip hotkey overlay",
    "desc": "Don't show the keybind cheat sheet when the session starts",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "SCREENSHOTS",
    "key": "wm.niri.screenshotPath",
    "label": "Save screenshots to",
    "desc": "Where the compositor's own screenshot lands. %Y, %m and %d become the date",
    "ctl": "text",
    "src": "desktop.json",
    "eg": "~/Pictures/Screenshots/Screenshot %Y-%m-%d.png",
    "page": "windowmanager",
    "adv": true
  }
]
