#!/usr/bin/env bash
# Summon a single-instance window to the current workspace and focus it; launch
# it if it isn't running yet. Single-instance apps (flock + qs) otherwise strand
# their window on whatever workspace they first opened on, so re-pressing the
# keybind from another workspace appears to do nothing.
#   ryoku-summon <window-title> <launch command...>
#
# The raise path matches by title, which the app-focus seam key does not model:
# it keys on app_id, and every Quickshell window shares org.quickshell, so a
# title is the only thing that tells them apart. The window manager is reached
# only through the seam: `ryoku wm act window.summon` raises the open window on
# whichever compositor is live and exits non-zero when nothing matches, which is
# what lets this fall through to the launch. The flock in the command then keeps
# a second press from opening a duplicate.
set -uo pipefail

title="${1:?window title required}"; shift
[ "$#" -gt 0 ] || { echo "ryoku-summon: launch command required" >&2; exit 2; }

# The window manager is reached only through the seam, never by name.
ryoku_bin="${RYOKU_BIN-$(command -v ryoku || true)}"

# A live window matching the title is raised and focused through the seam; when
# nothing matches the action exits non-zero and the launch command runs instead.
if [[ -n $ryoku_bin && -x $ryoku_bin ]]; then
	"$ryoku_bin" wm act window.summon "$title" >/dev/null 2>&1 && exit 0
fi

exec "$@"
