#!/bin/bash
# Ryoku Motion studio capture. Records the screen with gpu-screen-recorder (the
# same path the shell's Quick capture uses) AND samples the cursor, then writes
# OpenScreen's <video>.cursor.json sidecar and opens the clip in the ryomotion
# editor -- so the editor's automatic cursor-follow zoom still works even though
# gsr itself carries no cursor track.
#
#   ryoku-cmd-studiorecord [--with-desktop-audio] [--with-microphone-audio]
#
# The shell island starts this and stops it with SIGTERM (which finalises the
# clip, writes the cursor sidecar, and opens the editor).
set -uo pipefail

state_dir="${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}"
last_rec="$state_dir/last-recording"
here="$(dirname "$(readlink -f "$0")")"
# ryoku-cmd-screenrecord is a sibling in the install bin dir; fall back to PATH
# when this runs from a source tree where the two no longer sit together.
screenrec="$here/ryoku-cmd-screenrecord"
[[ -x $screenrec ]] || screenrec="ryoku-cmd-screenrecord"
raw="$(mktemp "${TMPDIR:-/tmp}/ryoku-cursor.XXXXXX")"
sampler_pid=""
done=0

# The window manager is reached only through the seam, asked by capability and
# never by name.
ryoku_bin="${RYOKU_BIN-$(command -v ryoku || true)}"

wm_can() {  # capability -> 0 when the live compositor honours it
  [[ -n $ryoku_bin && -x $ryoku_bin ]] || return 1
  case ",$("$ryoku_bin" wm status 2>/dev/null | sed -n 's/^Capabilities: //p' | tr -d '[:space:]')," in
    *",$1,"*) return 0 ;;
  esac
  return 1
}

# Cursor-follow zoom needs a live pointer read, which the window manager answers
# only where it honours live config eval. The read itself is a compositor payload
# (ryoku-cursor-track ships with the Hyprland session), so ask by capability and
# by whether the tracker is on PATH. Where it is not, the clip still records
# through the plain focused-output path (what ryoku-cmd-screenrecord does), just
# without the cursor sidecar the editor auto-zoom uses; say so once so the missing
# zoom is not a mystery.
#
# The tracker is one long-lived process: it prints the focused monitor geometry
# (logical pixels, to normalise the global cursor position to 0..1 within the
# recorded screen) on its first stdout line, then samples the pointer into $raw
# until finish() kills it. It starts once the recorder is capturing, so the
# sidecar clock lines up with the video. have_cursor stays 0 unless it started
# and printed a usable geometry line.
have_cursor=0
MX=0; MY=0; MW=1920; MH=1080
cursor_feed=0
if wm_can liveConfigEval && command -v ryoku-cursor-track >/dev/null 2>&1; then
  cursor_feed=1
elif command -v notify-send >/dev/null 2>&1; then
  notify-send -a ryoku-cli "Ryoku Motion" \
    "Cursor-follow zoom needs the running compositor's support; recording without it" >/dev/null 2>&1 || true
fi

start_tracker() {
  local tfd tx ty tw th
  exec {tfd}< <(ryoku-cursor-track "$raw")
  sampler_pid=$!
  read -r tx ty tw th <&"$tfd" || true
  exec {tfd}<&-
  if [[ ${tw:-} =~ ^[0-9.]+$ ]] && [[ $(awk -v w="${tw:-0}" 'BEGIN{print (w>0)}') == 1 ]]; then
    have_cursor=1
    # A region capture already re-based the sidecar to its box; only a
    # full-screen recording takes the monitor geometry the tracker printed.
    if [[ -z $region_geom ]]; then
      MX="$tx"; MY="$ty"; MW="$tw"; MH="$th"
    fi
  else
    # No geometry line means no cursor feed (the tracker exited) or a bad read;
    # record without the sidecar and leave finish() no stray sampler to kill.
    [[ -n $sampler_pid ]] && kill "$sampler_pid" 2>/dev/null || true
    sampler_pid=""
  fi
}

# Region capture (from the shell island): --geometry WxH+X+Y crops the recording to
# the box and re-bases the cursor sidecar to it, so auto-zoom maps inside the region;
# without it we record the whole focused monitor. Other flags (audio) pass through.
region_geom=""
rec_args=()
while (($#)); do
  case "$1" in
  --region) ;;
  --geometry) shift; region_geom="${1:-}" ;;
  *) rec_args+=("$1") ;;
  esac
  shift
done
mode_args=(--fullscreen)
if [[ $region_geom =~ ^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$ ]]; then
  MW="${BASH_REMATCH[1]}"; MH="${BASH_REMATCH[2]}"
  MX="${BASH_REMATCH[3]}"; MY="${BASH_REMATCH[4]}"
  mode_args=(--region --geometry "$region_geom")
fi

finish() {
  [[ $done -eq 1 ]] && return 0
  done=1
  "$screenrec" --stop >/dev/null 2>&1 || true
  [[ -n $sampler_pid ]] && kill "$sampler_pid" 2>/dev/null || true
  sleep 1.2 # let gpu-screen-recorder finalise the mp4 container

  local video
  video="$(cat "$last_rec" 2>/dev/null || true)"
  if [[ -n $video && -f $video ]]; then
    # Only when a cursor feed was available: the sidecar is what carries the track.
    (( have_cursor )) && [[ -s $raw ]] && awk -v mx="$MX" -v my="$MY" -v mw="$MW" -v mh="$MH" '
      BEGIN { printf "{\"version\":1,\"provider\":\"native\",\"assets\":[],\"samples\":["; sep="" }
      {
        cx=($2-mx)/mw; cy=($3-my)/mh;
        if (cx<0) cx=0; if (cx>1) cx=1; if (cy<0) cy=0; if (cy>1) cy=1;
        printf "%s{\"timeMs\":%d,\"cx\":%.5f,\"cy\":%.5f,\"interactionType\":\"move\"}", sep, $1, cx, cy;
        sep=","
      }
      END { printf "]}" }' "$raw" >"$video.cursor.json" 2>/dev/null || true

    if command -v ryomotion >/dev/null 2>&1; then
      setsid ryomotion "$video" >/dev/null 2>&1 &
    elif command -v notify-send >/dev/null 2>&1; then
      notify-send -a ryoku-cli "Ryoku Motion" "Recording saved; editor (ryomotion) not installed" || true
    fi
  fi
  rm -f "$raw" 2>/dev/null || true
}
trap 'finish; exit 0' TERM INT

"$screenrec" "${mode_args[@]}" "${rec_args[@]}" &
rec_pid=$!

# Align the cursor clock to when the recorder actually starts capturing, so the
# sidecar timestamps line up with the video.
if (( cursor_feed )); then
  for _ in $(seq 1 50); do
    pgrep -f '(^|/)gpu-screen-recorder( |$)' >/dev/null 2>&1 && break
    pgrep -f '(^|/)wf-recorder( |$)' >/dev/null 2>&1 && break
    sleep 0.1
  done
  start_tracker
fi

wait "$rec_pid" 2>/dev/null || true
finish
