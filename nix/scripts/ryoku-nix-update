set -euo pipefail

flake_root="${RYOKU_NIX_FLAKE:-/etc/nixos}"
input="${RYOKU_NIX_INPUT:-ryoku}"
installed="${RYOKU_NIX_VERSION:-}"
sudo_bin="${RYOKU_NIX_SUDO:-/run/wrappers/bin/sudo}"

# The packaged CLI normally supplies RYOKU_NIX_VERSION, but the update helper is
# also a public command and is called directly by other Ryoku surfaces. Fall
# back to the generation-owned release marker so every caller reports the
# installed release consistently.
if [ -z "$installed" ] && [ -r /etc/ryoku-release ]; then
    installed="$(
        sed -n '
            /^VERSION="/ {
                s/^VERSION="\([^"]*\)"$/\1/
                p
                q
            }
        ' /etc/ryoku-release
    )"
fi

lock="$flake_root/flake.lock"

die() {
    printf 'ryoku-nix-update: %s\n' "$*" >&2
    return 1
}

trim_version() {
    sed -n '1{s/\r$//;p;}'
}

version_is_newer() {
    old="$1"
    new="$2"

    [ -n "$old" ] || return 1
    [ -n "$new" ] || return 1
    [ "$old" != "$new" ] || return 1

    first="$(
        printf '%s\n%s\n' "$old" "$new" |
            sort -V |
            head -n 1
    )"

    [ "$first" = "$old" ]
}

github_slug_from_remote() {
    remote="$1"

    case "$remote" in
        https://github.com/*)
            slug="${remote#https://github.com/}"
            ;;
        git@github.com:*)
            slug="${remote#git@github.com:}"
            ;;
        ssh://git@github.com/*)
            slug="${remote#ssh://git@github.com/}"
            ;;
        *)
            return 1
            ;;
    esac

    slug="${slug%.git}"

    case "$slug" in
        */*)
            printf '%s\n' "$slug"
            ;;
        *)
            return 1
            ;;
    esac
}

fetch_github_version() {
    slug="$1"
    ref="$2"

    curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --max-time 20 \
        "https://raw.githubusercontent.com/$slug/$ref/VERSION" \
        2>/dev/null |
        trim_version
}

input_node() {
    jq -r \
        --arg input "$input" \
        '
            .nodes.root.inputs[$input] as $value
            | if ($value | type) == "string" then
                $value
              elif ($value | type) == "array" then
                $value[-1]
              else
                empty
              end
        ' \
        "$lock"
}

source_type=""
source_ref=""
source_path=""
source_remote=""
source_branch=""
channel="nix"
latest="$installed"
can_update=false

load_source() {
    [ -f "$lock" ] ||
        die "no flake.lock found at $lock"

    node="$(input_node)"

    [ -n "$node" ] ||
        die "flake input '$input' is not present in $lock"

    original="$(
        jq -c \
            --arg node "$node" \
            '.nodes[$node].original // {}' \
            "$lock"
    )"

    source_type="$(
        jq -r '.type // empty' <<< "$original"
    )"

    case "$source_type" in
        github)
            owner="$(jq -r '.owner // empty' <<< "$original")"
            repo="$(jq -r '.repo // empty' <<< "$original")"
            ref="$(jq -r '.ref // "HEAD"' <<< "$original")"

            [ -n "$owner" ] && [ -n "$repo" ] ||
                die "GitHub Ryoku input is missing owner/repo metadata"

            slug="$owner/$repo"
            channel="$ref"
            source_ref="github:$slug"

            if [ "$ref" != "HEAD" ]; then
                source_ref="$source_ref/$ref"
            fi

            can_update=true

            remote_version="$(
                fetch_github_version "$slug" "$ref" || true
            )"

            if [ -n "$remote_version" ]; then
                latest="$remote_version"
            fi
            ;;

        path)
            source_path="$(
                jq -r '.path // empty' <<< "$original"
            )"

            [ -n "$source_path" ] ||
                die "local Ryoku input has no path"

            case "$source_path" in
                /*)
                    ;;
                *)
                    source_path="$(
                        readlink -f "$flake_root/$source_path"
                    )"
                    ;;
            esac

            source_ref="path:$source_path"
            channel="local"
            can_update=false

            if [ -f "$source_path/VERSION" ]; then
                local_version="$(
                    trim_version < "$source_path/VERSION"
                )"

                if [ -n "$local_version" ]; then
                    latest="$local_version"
                fi
            fi

            # A path input remains authoritative, but a clean Git checkout can
            # safely participate in the normal updater. Status never mutates it:
            # it only discovers origin/current-branch and, for GitHub origins,
            # reads that branch's VERSION. `update` does the guarded fast-forward.
            if git -C "$source_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
                source_remote="$(
                    git -C "$source_path" remote get-url origin 2>/dev/null || true
                )"
                source_branch="$(
                    git -C "$source_path" symbolic-ref --quiet --short HEAD 2>/dev/null || true
                )"

                if [ -n "$source_branch" ]; then
                    channel="local:$source_branch"
                fi

                if [ -n "$source_remote" ] && [ -n "$source_branch" ]; then
                    if [ -z "$(git -C "$source_path" status --porcelain --untracked-files=normal)" ]; then
                        can_update=true
                    fi

                    slug="$(github_slug_from_remote "$source_remote" 2>/dev/null || true)"
                    if [ -n "$slug" ]; then
                        remote_version="$(
                            fetch_github_version "$slug" "$source_branch" || true
                        )"
                        if [ -n "$remote_version" ]; then
                            latest="$remote_version"
                        fi
                    fi
                fi
            fi
            ;;

        *)
            source_ref="$source_type"
            channel="nix"
            can_update=false
            ;;
    esac
}

status_json() {
    load_source

    available=false
    pending=0
    updates='[]'
    recent='[]'

    if version_is_newer "$installed" "$latest"; then
        available=true
        pending=1

        updates="$(
            jq -cn \
                --arg old "$installed" \
                --arg new "$latest" \
                '[
                    {
                        name: "Ryoku for NixOS",
                        old: $old,
                        new: $new
                    }
                ]'
        )"
    else
        recent="$(
            jq -cn \
                --arg version "$installed" \
                '[
                    {
                        name: "Ryoku for NixOS",
                        old: "",
                        new: $version
                    }
                ]'
        )"
    fi

    jq -cn \
        --arg installedVersion "$installed" \
        --arg latestVersion "$latest" \
        --arg channel "$channel" \
        --arg source "$source_ref" \
        --argjson available "$available" \
        --argjson pendingUpdates "$pending" \
        --argjson canUpdate "$can_update" \
        --argjson updates "$updates" \
        --argjson recent "$recent" \
        '{
            installedVersion: $installedVersion,
            latestVersion: $latestVersion,
            available: $available,
            pendingUpdates: $pendingUpdates,
            updates: $updates,
            recent: $recent,
            channel: $channel,
            snapshots: 0,
            packages: [],
            backend: "nix",
            canUpdate: $canUpdate,
            source: $source
        }'
}

resolve_host() {
    if [ -n "${RYOKU_NIX_HOST:-}" ]; then
        printf '%s\n' "$RYOKU_NIX_HOST"
        return 0
    fi

    hosts_json="$(
        nix eval \
            --json \
            "${flake_root}#nixosConfigurations" \
            --apply builtins.attrNames
    )"

    mapfile -t hosts < <(
        jq -r '.[]' <<< "$hosts_json"
    )

    [ "${#hosts[@]}" -gt 0 ] ||
        die "no nixosConfigurations found in $flake_root"

    if [ "${#hosts[@]}" -eq 1 ]; then
        printf '%s\n' "${hosts[0]}"
        return 0
    fi

    current_host="$(hostname)"

    for candidate in "${hosts[@]}"; do
        configured="$(
            nix eval \
                --raw \
                "${flake_root}#nixosConfigurations.${candidate}.config.networking.hostName" \
                2>/dev/null || true
        )"

        if [ "$configured" = "$current_host" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    die "could not determine the active NixOS host"
}

update_nix() {
    load_source

    local_checkout=false

    if [ "$source_type" = "path" ]; then
        local_checkout=true

        git -C "$source_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
            die "local Ryoku path is not a Git checkout: $source_path"

        dirty="$(git -C "$source_path" status --porcelain --untracked-files=normal)"
        [ -z "$dirty" ] ||
            die "local Ryoku checkout has uncommitted changes; commit or stash them before updating"

        source_remote="$(
            git -C "$source_path" remote get-url origin 2>/dev/null || true
        )"
        source_branch="$(
            git -C "$source_path" symbolic-ref --quiet --short HEAD 2>/dev/null || true
        )"

        [ -n "$source_remote" ] ||
            die "local Ryoku checkout has no origin remote"
        [ -n "$source_branch" ] ||
            die "local Ryoku checkout is detached; switch to a branch before updating"

        printf 'Checking local Ryoku checkout: %s (%s)\n' \
            "$source_path" "$source_branch"

        # Fetch only the checked-out branch. Nothing is merged until we prove a
        # fast-forward is possible, so a diverged development branch is never
        # rewritten or rebased behind the user's back.
        git -C "$source_path" fetch --prune origin \
            "+refs/heads/$source_branch:refs/remotes/origin/$source_branch"

        before="$(git -C "$source_path" rev-parse HEAD)"
        target="refs/remotes/origin/$source_branch"
        remote_head="$(git -C "$source_path" rev-parse "$target")"

        if [ "$before" = "$remote_head" ]; then
            printf 'Local Ryoku checkout is already at origin/%s.\n' "$source_branch"
        elif git -C "$source_path" merge-base --is-ancestor "$before" "$target"; then
            printf 'Fast-forwarding local Ryoku checkout.\n'
            git -C "$source_path" merge --ff-only "$target"
        elif git -C "$source_path" merge-base --is-ancestor "$target" "$before"; then
            printf 'Local Ryoku checkout is ahead of origin/%s; keeping local commits.\n' "$source_branch"
        else
            die "local Ryoku checkout diverged from origin/$source_branch; resolve it manually"
        fi

        if [ -f "$source_path/VERSION" ]; then
            latest="$(trim_version < "$source_path/VERSION")"
        fi
    else
        [ -n "$latest" ] ||
            die "could not resolve the latest Ryoku Nix version"

        if [ "$installed" = "$latest" ]; then
            printf 'Ryoku for NixOS is already %s.\n' "$installed"
            return 0
        fi

        if ! version_is_newer "$installed" "$latest"; then
            die "refusing to move from $installed to non-newer version $latest"
        fi
    fi

    host="$(resolve_host)"

    [ -x "$sudo_bin" ] ||
        die "NixOS sudo wrapper is unavailable at $sudo_bin"

    nix_bin="$(command -v nix)"
    nixos_rebuild_bin="$(command -v nixos-rebuild)"
    cp_bin="$(command -v cp)"

    [ -x "$nix_bin" ] ||
        die "nix executable is unavailable"

    [ -x "$nixos_rebuild_bin" ] ||
        die "nixos-rebuild executable is unavailable"

    [ -x "$cp_bin" ] ||
        die "cp executable is unavailable"

    backup="$(mktemp)"
    cp "$lock" "$backup"

    restore_lock=true

    cleanup() {
        if [ "$restore_lock" = true ]; then
            printf 'Restoring the previous Ryoku flake lock.\n' >&2
            "$sudo_bin" "$cp_bin" "$backup" "$lock" || true
        fi

        rm -f "$backup"
    }

    trap cleanup EXIT INT TERM

    if [ "$local_checkout" = true ]; then
        printf 'Refreshing Ryoku local flake input: %s\n' "$input"
    else
        printf 'Ryoku for NixOS: %s -> %s\n' \
            "$installed" \
            "$latest"
        printf 'Updating flake input: %s\n' "$input"
    fi

    "$sudo_bin" "$nix_bin" flake update \
        "$input" \
        --flake "$flake_root"

    printf 'Building NixOS configuration: %s\n' "$host"

    "$sudo_bin" "$nix_bin" build \
        "${flake_root}#nixosConfigurations.${host}.config.system.build.toplevel" \
        --no-link

    printf 'Switching to the new NixOS generation.\n'

    "$sudo_bin" "$nixos_rebuild_bin" switch \
        --flake "${flake_root}#${host}"

    restore_lock=false
    rm -f "$backup"
    trap - EXIT INT TERM

    printf 'Ryoku for NixOS update complete.\n'
}

case "${1:-status}" in
    status)
        status_json
        ;;
    update)
        update_nix
        ;;
    *)
        die "usage: ryoku-nix-update {status|update}"
        ;;
esac
