# Maintainer: Ryoku <releases@ryoku.dev>
#
# prowl-agent: the code-intelligence indexer and MCP server Ryoku ships for its
# agent OS. Built from github.com/neur0map/prowl-agent at a pinned commit and
# installed as /usr/bin/prowl-agent. Ryoku Rashin drives it -- `ryoku-rashin
# index` builds the vault's code map with it and `ryoku-rashin wire` installs its
# agent skills -- so ryoku-rashin depends on this package and the desktop set
# ships it. `ryoku update` keeps a dev box's own copy current; a packaged box
# gets new builds through `pacman -Syu`, and the managed-binary guard
# (-X main.managedBy=pacman) makes a hand-run `prowl-agent update` defer to the
# package manager instead of overwriting the pacman-owned binary.
#
# Go build with cgo: the indexer links SQLite's FTS5 (CGO_ENABLED=1,
# -tags sqlite_fts5), so gcc/gcc-libs are in play and the module cache is fetched
# at build time (upstream carries no vendored tree). Like ryomotion, the source
# is a pinned git commit. Bump _commit (and pkgrel, or pkgver when
# cmd/prowl-agent/main.go's `var version` moves) to ship a new build to users.
pkgname=prowl-agent
pkgver=0.15.6
pkgrel=1
pkgdesc="Prowl: code-intelligence indexer and MCP server for the Ryoku agent OS"
arch=('x86_64')
url="https://github.com/neur0map/prowl-agent"
license=('custom')
depends=('gcc-libs')
makedepends=('go' 'git' 'gcc')
# cgo (sqlite_fts5) does not survive makepkg's LTO, and the Go binary is already
# stripped by -ldflags "-s -w", so skip the empty debug package.
options=('!lto' '!debug')
_commit=506e54fb7b049ceea556255205f8acd3ee20ac9e
source=("$pkgname::git+https://github.com/neur0map/prowl-agent.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"
  export CGO_ENABLED=1
  export GOPATH="$srcdir/gopath"
  export GOCACHE="$srcdir/gocache"
  export GOFLAGS="-mod=mod"
  # -o into a subdir: $srcdir/prowl-agent is the git checkout, so the binary
  # cannot share that name. main.version stamps the reported version;
  # main.managedBy=pacman flips the self-update guard so a hand-run
  # `prowl-agent update` defers to pacman on a packaged box.
  go build -trimpath -tags sqlite_fts5 \
    -ldflags "-s -w -X main.version=v$pkgver -X main.managedBy=pacman" \
    -o "$srcdir/out/prowl-agent" ./cmd/prowl-agent
}

package() {
  install -Dm755 "$srcdir/out/prowl-agent" "$pkgdir/usr/bin/prowl-agent"
}
